<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preserve Authorization header for API/Sanctum
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send all requests into Laravel's public front controller tree.
    # Avoid [N] rewrite loops that can 502 on LiteSpeed/Hostinger.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
